<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sotn</AssemblyName>
    <ApplicationIcon>assets/icon/SymphonyRecomp.ico</ApplicationIcon>
    <NoWarn>0162</NoWarn>
    <!-- Android/** is the net10.0-android head (RecompOne.SoTN.Android.csproj); it references
         the Android SDK bindings and must not be compiled into the desktop build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);RecompOne/**;Android/**;jdk/**</DefaultItemExcludes>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" UndefineProperties="OutputType" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/tracker/*.png" />
    <EmbeddedResource Include="assets/map/*.png" />
    <EmbeddedResource Include="assets/extension/*.png" />
    <EmbeddedResource Include="assets/icon/*.ico" />
    <EmbeddedResource Include="assets/languages.json" />
  </ItemGroup>
</Project>
